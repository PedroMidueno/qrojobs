{
  "name": "qrojobs",
  "version": "0.0.1",
  "description": "QroJobs is a job-searching platform focused on Queretaro, Mexico",
  "main": "index.js",
  "scripts": {
    "dev:web": "pnpm --filter @qrojobs/web dev",
    "dev:api": "pnpm --filter @qrojobs/api start:dev",
    "dev:all": "concurrently --kill-others --names web,api \"pnpm dev:web\" \"pnpm dev:api\""
  },
  "author": {
    "name": "Pedro Midueño",
    "url": "https://pemid.dev",
    "email": "pedromidueno.dev@gmail.com"
  },
  "license": "AGPL-3.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  }
}
